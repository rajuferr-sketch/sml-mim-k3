# SML-MIM-K3 Environment Configuration

# Foundation Model & Backend API Keys
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
MOONSHOT_API_KEY=your_kimi_moonshot_api_key_here

# Swarm & Orchestration Settings
SWARM_MODEL_NAME=sml-mim-k3-800b
SWARM_TOTAL_AGENTS=25
SWARM_CONSENSUS_THRESHOLD=0.80
SWARM_TIMEOUT_SECONDS=120
SWARM_SHARED_MEMORY_LIMIT_MB=2048
SWARM_OUTPUT_DIR=./runs

# MCP Server Settings
MCP_SERVER_HOST=127.0.0.1
MCP_SERVER_PORT=8000
MCP_LOG_LEVEL=INFO
